# Environment variables for the backend application
# Server
PORT=5000

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=tender_management_db
DB_DIALECT=mysql

# Optional: JWT or session secret (if using auth)
JWT_SECRET=88c6eda0169a168e9ae9f155e088b70680d42c7dfbd60a86c941c31067f02102788c862a99b815ae8d2982a5abe7c0ce47493b0a1216a2519edaeb197b486b1b

JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=your-refresh-token-secret-here
JWT_REFRESH_EXPIRY=7d





# Application Environment
NODE_ENV=development
PORT=5000
APP_NAME="Tender Management System"
APP_URL=http://localhost:5000

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=tender_db
DB_USERNAME=root
DB_PASSWORD=
DB_DIALECT=mysql

# Alternative: Database URL (if using cloud database)
# DATABASE_URL=mysql://username:password@host:port/database

# Security Configuration
# JWT_SECRET=your-super-secret-jwt-key-here-make-it-long-and-random
# JWT_EXPIRY=24h
# JWT_REFRESH_SECRET=your-refresh-token-secret-here
# JWT_REFRESH_EXPIRY=7d

# Password Hashing
BCRYPT_SALT_ROUNDS=12

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="Tender Management System <noreply@tendermanagement.com>"

# File Upload Configuration
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=pdf,doc,docx,xls,xlsx,jpg,jpeg,png

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Session Configuration
SESSION_SECRET=your-session-secret-here
SESSION_NAME=tender_session
SESSION_MAX_AGE=86400000

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# External APIs (if needed)
# PAYMENT_API_KEY=your-payment-api-key
# SMS_API_KEY=your-sms-api-key

# Development/Debug
DEBUG=app:*
SEQUELIZE_LOGGING=true

# Production overrides (set these in production)
# NODE_ENV=production
# SEQUELIZE_LOGGING=false
# DEBUG=false